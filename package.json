{
  "name": "goodcash",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "test": "npm --workspace apps/web run test",
    "test:orders": "npm --workspace services/orders run test",
    "test:all": "npm --workspace packages/core run test && npm --workspace packages/sdk run test && npm --workspace packages/react run test && npm --workspace apps/widget run test && npm --workspace apps/web run test && npm --workspace services/orders run test && npm run contracts:test",
    "lint": "npm --workspace apps/web run lint",
    "typecheck": "npm --workspace apps/web run typecheck",
    "contracts:test": "cd packages/contracts && CELO_RPC_URL=${CELO_RPC_URL:-https://forno.celo.org} forge test",
    "contracts:build": "cd packages/contracts && forge build",
    "test:core": "npm --workspace packages/core run test",
    "test:sdk": "npm --workspace packages/sdk run test",
    "test:react": "npm --workspace packages/react run test",
    "test:widget": "npm --workspace apps/widget run test",
    "e2e:widget": "npm --workspace apps/widget run e2e"
  },
  "devDependencies": {
    "@goodsdks/citizen-sdk": "^1.2.7",
    "@goodsdks/identity-sdk": "^1.0.5",
    "autoprefixer": "^10.6.2",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4"
  }
}
