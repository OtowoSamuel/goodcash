{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@goodcash/sdk": ["../../packages/sdk/src/index.ts"],
      "@goodcash/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/docs.test.ts"]
}
