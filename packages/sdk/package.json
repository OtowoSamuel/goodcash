{
  "name": "@goodcash/sdk",
  "version": "0.1.0",
  "description": "Let your users cash out GoodDollar (G$) to a Nigerian bank account, from your own app or game.",
  "license": "MIT",
  "homepage": "https://goodcash.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/OtowoSamuel/goodcash.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "gooddollar",
    "celo",
    "naira",
    "cash out",
    "offramp",
    "payments"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
