{
  "name": "@goodcash/react",
  "version": "0.2.0",
  "description": "A ready-made 'Cash out to bank' button and hooks for GoodDollar (G$) to naira, for React apps.",
  "license": "MIT",
  "homepage": "https://goodcash.xyz",
  "repository": { "type": "git", "url": "https://github.com/OtowoSamuel/goodcash.git", "directory": "packages/react" },
  "keywords": ["gooddollar", "celo", "naira", "cash out", "react", "widget"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@goodcash/sdk": "^0.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@goodcash/sdk": "0.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
